# Copy to .env and supply settings for your deployment.
DB_USER=USER
DB_PASSWORD=PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_PERSISTENT_SECRET
MQTT_BROKER_HOST=192.168.1.100
RESEND_API_KEY=YOUR_RESEND_API_KEY
ALERT_FROM=onboarding@resend.dev
ALERT_TO=you@example.com
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
# Gmail receipt delivery uses the credentials above independently of reply polling.
# Set to gmail for Gmail SMTP, or resend for the existing Resend integration.
RECEIPT_EMAIL_PROVIDER=resend

# Checkout-only development: use an absolute SQLite path and disable hardware.
# DATABASE_URL=sqlite:////absolute/path/to/smartshop.db
DB_HOST=localhost
DB_NAME=smartshop
# Set a random persistent SECRET_KEY (e.g. python -c 'import secrets; print(secrets.token_hex(32))').
COOKIE_SECURE=false
FRIDGE_SERVICES_ENABLED=true
GMAIL_SERVICE_ENABLED=true
MEMBERSHIP_SERVICE_ENABLED=false
FAKE_READERS_ENABLED=false
# CF600 in CDC-COM mode: set PRODUCT_READER_BACKEND=cf600_serial.
PRODUCT_READER_BACKEND=disabled
CF600_SERIAL_DEVICE=/dev/serial/by-id/usb-CFUSB_HID_By_YLW28-if03-port0
CF600_BAUDRATE=57600
# Optional legacy keyboard backend cf600_hid requires Tab after each EPC.
CF600_INPUT_DEVICE=/dev/input/by-id/usb-CFUSB_HID_By_YLW28-if01-event-kbd
MQTT_BROKER_PORT=1883
MQTT_USERNAME=YOUR_BACKEND_MQTT_USER
MQTT_PASSWORD=YOUR_BACKEND_MQTT_PASSWORD
MQTT_TLS=false
MEMBERSHIP_TOPIC=SmartShop/membership
# Resend receipts only: verified sender; Gmail receipts send from GMAIL_ADDRESS.
RECEIPT_FROM=receipts@example.com
